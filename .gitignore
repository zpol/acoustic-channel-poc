__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Keep curated blog/demo samples; ignore ad-hoc capture dumps
output/*
!output/.gitkeep
!output/samples/
!output/samples/**
!output/screenshots/
!output/screenshots/**
!output/article/
!output/article/**
# Never commit anything with POL in the name
**/*POL*
**/*pol*
*.egg-info/
dist/
build/
.DS_Store

# Raw physical dumps (curated copies live under output/samples/)
experiments/*
!experiments/.gitkeep

# Local lab overrides (may contain RFC1918 addresses / usernames)
configs/local-lab.env
.lab/
