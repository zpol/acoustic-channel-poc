# Local lab overrides (do NOT commit secrets or RFC1918 addresses).
# Copy to configs/local-lab.env and fill in your TX host:
#
#   cp configs/local-lab.env.example configs/local-lab.env
#   source configs/local-lab.env
#
# Or export once per shell:
#   export ACOUSTIC_REMOTE_TX=demo-user@tx-host
#   export ACOUSTIC_REMOTE_DIR=/path/to/repository

export ACOUSTIC_REMOTE_TX="demo-user@tx-host"
export ACOUSTIC_REMOTE_DIR="/path/to/repository"
# Optional: default remote speaker index on the TX host
export ACOUSTIC_REMOTE_OUTPUT_DEVICE="1"
